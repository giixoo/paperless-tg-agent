# Required
TELEGRAM_BOT_TOKEN=
TELEGRAM_ALLOWED_USERS=
PAPERLESS_URL=http://webserver:8000
PAPERLESS_TOKEN=
ANTHROPIC_API_KEY=

# Optional (defaults shown)
PAPERLESS_PUBLIC_URL=
PAPERLESS_API_VERSION=9
LLM_MODEL=claude-haiku-4-5
AGENT_MAX_STEPS=5
AGENT_MAX_TOKENS=1024
DOC_CONTENT_MAX_CHARS=3000
HISTORY_TURNS=6
DAILY_BUDGET_USD=0.20
PRICE_INPUT_PER_MTOK=1.00
PRICE_OUTPUT_PER_MTOK=5.00
PRICE_CACHE_WRITE_PER_MTOK=1.25
PRICE_CACHE_READ_PER_MTOK=0.10
EXPIRY_FIELD_NAME=Expires
REMINDER_ENABLED=true
REMINDER_TIME=09:00
REMINDER_DAYS=30
HIDDEN_TAG_PREFIXES=gpt,sonnet
DUPS_ENABLED=true
DUPS_SCAN_TIME=03:30
DUPS_THRESHOLD=0.80
DUPS_NUMBERS_THRESHOLD=0.70
DUPS_MIN_CHARS=200
DUPS_SKIP_TAGS=gpt-ocr,gpt-auto,sonnet-ocr,sonnet-auto
DUPS_NOTIFY=true
DUPS_NOTIFY_TIME=09:00
TZ=Europe/Warsaw
DATA_DIR=/data
HEALTH_PORT=8080
LOG_LEVEL=INFO
